{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm verify)",
			"Bash(pnpm lint)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm build)",
			"Bash(pnpm format:check)",
			"Bash(pnpm install)",
			"Bash(pnpm install --frozen-lockfile)",
			"Bash(pnpm tokens:build)",
			"Bash(pnpm web:build)",
			"Bash(pnpm admin:build)",
			"Bash(pnpm pres:build)",
			"Bash(pnpm media:build)",
			"Bash(pnpm --filter * lint)",
			"Bash(pnpm --filter * typecheck)",
			"Bash(pnpm --filter * build)",
			"Bash(pnpm --filter * test:e2e)",
			"Bash(pnpm turbo run lint typecheck)",
			"Bash(pnpm turbo run *--dry*)",
			"Bash(pnpm list:*)",
			"Bash(pnpm why:*)",
			"Bash(pnpm outdated:*)",

			"Bash(git status:*)",
			"Bash(git log:*)",
			"Bash(git diff:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git remote -v)",
			"Bash(git ls-files:*)",
			"Bash(git check-ignore:*)",
			"Bash(git rev-parse:*)",
			"Bash(git blame:*)",

			"Bash(gh pr view:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh run list:*)",
			"Bash(gh run view:*)",
			"Bash(gh issue view:*)",
			"Bash(gh issue list:*)",
			"Bash(gh api repos/*)",

			"Bash(ls:*)",
			"Bash(find:*)",
			"Bash(wc:*)",
			"Bash(which:*)",
			"Bash(node --version)",
			"Bash(pnpm --version)",

			"WebFetch(domain:nextjs.org)",
			"WebFetch(domain:sanity.io)",
			"WebFetch(domain:www.sanity.io)",
			"WebFetch(domain:svelte.dev)",
			"WebFetch(domain:kit.svelte.dev)",
			"WebFetch(domain:revealjs.com)",
			"WebFetch(domain:docs.astro.build)",
			"WebFetch(domain:styledictionary.com)",
			"WebFetch(domain:turbo.build)",
			"WebFetch(domain:pnpm.io)",
			"WebFetch(domain:react.email)",
			"WebFetch(domain:resend.com)",
			"WebFetch(domain:docs.railway.com)",
			"WebFetch(domain:infisical.com)",
			"WebFetch(domain:playwright.dev)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:www.npmjs.com)",
			"WebSearch",

			"mcp__claude_ai_Sanity__get_schema",
			"mcp__claude_ai_Sanity__list_datasets",
			"mcp__claude_ai_Sanity__query_documents",
			"mcp__claude_ai_Sanity__get_document",
			"mcp__claude_ai_Sanity__search_docs",
			"mcp__claude_ai_Sanity__read_docs",
			"mcp__claude_ai_Sanity__list_sanity_rules",
			"mcp__claude_ai_Sanity__get_sanity_rules",
			"mcp__claude_ai_Notion__notion-fetch",
			"mcp__claude_ai_Notion__notion-search",
			"mcp__claude_ai_Notion__notion-query-data-sources",
			"mcp__claude_ai_Figma__get_design_context",
			"mcp__claude_ai_Figma__get_metadata",
			"mcp__claude_ai_Figma__get_screenshot",
			"mcp__claude_ai_Figma__get_variable_defs",
			"mcp__plugin_railway_railway__list-projects",
			"mcp__plugin_railway_railway__list-services",
			"mcp__plugin_railway_railway__list-deployments",
			"mcp__plugin_railway_railway__list-domains",
			"mcp__plugin_railway_railway__list-variables",
			"mcp__plugin_railway_railway__get-logs",
			"mcp__plugin_railway_railway__get-status",
			"mcp__plugin_railway_railway__get-service-config",
			"mcp__plugin_railway_railway__search-docs"
		],
		"ask": [
			"Bash(git push:*)",
			"Bash(gh pr create:*)",
			"Bash(gh pr merge:*)",
			"Bash(gh workflow enable:*)",
			"Bash(gh workflow disable:*)",
			"Bash(pnpm --filter admin deploy)",
			"Bash(sanity deploy:*)",
			"mcp__claude_ai_Notion__notion-update-page",
			"mcp__claude_ai_Notion__notion-create-pages",
			"mcp__plugin_railway_railway__set-variables",
			"mcp__plugin_railway_railway__redeploy",
			"mcp__plugin_railway_railway__create-deployment",
			"mcp__claude_ai_Sanity__create_documents",
			"mcp__claude_ai_Sanity__patch_documents",
			"mcp__claude_ai_Sanity__publish_documents",
			"mcp__claude_ai_Sanity__deploy_studio"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./apps/**/.env)",
			"Read(./apps/**/.env.*)",
			"Read(./apps/**/.infisical.json)",
			"Bash(git push --force*)",
			"Bash(pnpm publish:*)",
			"Bash(npm publish:*)"
		]
	}
}
