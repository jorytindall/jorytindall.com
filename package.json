{
	"private": true,
	"name": "jorytindall",
	"description": "Monorepo for my personal website and projects",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"web:dev": "turbo run dev --filter=web",
		"web:build": "turbo run build --filter=web",
		"admin:dev": "turbo run dev --filter=admin",
		"admin:build": "turbo run build --filter=admin",
		"tokens:build": "turbo run build --filter=tokens",
		"pres:dev": "turbo run dev --filter=presentations",
		"pres:build": "turbo run build --filter=presentations",
		"media:dev": "turbo run dev --filter=media-center",
		"media:build": "turbo run build --filter=media-center",
		"format:all": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"verify": "turbo run lint typecheck",
		"dev": "turbo run dev"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"turbo": "^2.9.12",
		"typescript": "^6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jorytindall/jorytindall"
	},
	"keywords": [
		"design",
		"design systems",
		"javascript",
		"react",
		"music"
	]
}