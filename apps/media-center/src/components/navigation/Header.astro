---
import styles from './Header.module.css';
import ThemePicker from './ThemePicker.astro';

interface Props {
	user: { username: string; email: string; thumb: string } | null;
}

const { user } = Astro.props;
---

<header class={styles.header} id="site-header">
	<a href="/" class={styles.brand}>Media Center</a>
	<nav class={styles.nav}>
		<a href="/docs" class={styles.navLink}>Docs</a>
		{user && (
			<div class={styles.user}>
				<img src={user.thumb} alt={user.username} class={styles.avatar} />
				<span class={styles.username}>{user.username}</span>
				<a href="/auth/logout" class={styles.logout}>Sign out</a>
			</div>
		)}
		<ThemePicker />
	</nav>
</header>

<script>
	function initScrollDetection() {
		const header = document.getElementById('site-header');
		if (!header) return;

		const onScroll = () => {
			header.classList.toggle('scrolled', window.scrollY > 0);
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	initScrollDetection();
	document.addEventListener('astro:after-swap', initScrollDetection);
</script>
