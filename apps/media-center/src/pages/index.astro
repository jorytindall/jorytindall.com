---
import Layout from '../components/layout/Layout.astro';
import ServiceCard from '../components/navigation/ServiceCard.astro';

const user = Astro.locals.user;
---

<Layout title="Dashboard">
	<div class="dashboard">
		<section class="welcome">
			<h1>Welcome{user ? `, ${user.username}` : ''}</h1>
			<p>
				You've got the keys to the kingdom. Stream whatever you want, request anything
				that's missing, and let the robots handle the rest.
			</p>
		</section>

		<section class="services">
			<h2>Services</h2>
			<div class="service-grid">
				<ServiceCard
					name="Plex"
					description="The main event. Movies, shows, music — all streaming and ready to go."
					href="https://watch.jorytindall.tv"
					cta="Start watching"
				/>
				<ServiceCard
					name="Request content"
					description="Don't see what you're looking for? Request it and it'll show up like magic. You'll be redirected to the Seerr app to browse and make requests."
					href="https://request.jorytindall.tv"
					cta="Request something"
				/>
			</div>
		</section>

		<section class="faq-callout">
			<div class="faq-inner">
				<h2>First time here?</h2>
				<p>Check the FAQ for everything you need to know — what this is, how it works, and how to get the best experience.</p>
				<a href="/docs/streaming-faq" class="faq-link">Read the Streaming FAQ &rarr;</a>
			</div>
		</section>

		<section class="quick-links">
			<h2>Learn the Ropes</h2>
			<ul>
				<li><a href="/docs/getting-started">Getting Started</a></li>
				<li><a href="/docs/requesting-content">How to Request Content</a></li>
				<li><a href="/docs/plex-apps">Plex Apps &amp; Settings</a></li>
			</ul>
		</section>
	</div>
</Layout>

<style>
	.dashboard {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem;
	}

	.welcome {
		margin-bottom: 2.5rem;
	}

	.welcome h1 {
		font-size: var(--typography-font-size-headline-02);
		margin-bottom: 0.5rem;
	}

	.welcome p {
		color: var(--color-core-neutral-500);
		font-size: var(--typography-font-size-body-primary);
	}

	.services {
		margin-bottom: 2.5rem;
	}

	.services h2,
	.quick-links h2 {
		font-size: var(--typography-font-size-headline-04);
		margin-bottom: 1rem;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}

	.faq-callout {
		margin-bottom: 2.5rem;
	}

	.faq-inner {
		background-color: var(--color-core-primary-100);
		border: 1px solid var(--color-core-primary-200);
		border-radius: 12px;
		padding: 1.75rem 2rem;
	}

	.faq-inner h2 {
		font-size: var(--typography-font-size-headline-04);
		margin-bottom: 0.375rem;
	}

	.faq-inner p {
		color: var(--color-core-neutral-500);
		font-size: 0.9375rem;
		margin-bottom: 1rem;
	}

	.faq-link {
		display: inline-block;
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-core-primary-300);
		text-decoration: none;
	}

	.faq-link:hover {
		text-decoration: underline;
	}

	.quick-links ul {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.quick-links a {
		color: var(--color-core-primary-300);
		font-size: 0.9375rem;
	}
</style>
