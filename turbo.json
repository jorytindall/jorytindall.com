{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"./.next/**",
				"./dist/**",
				"./svelte-kit/**"
			]
		},
		"test": {},
		"lint": {
			"outputs": []
		},
		"deploy": {
			"dependsOn": [
				"build",
				"test",
				"lint"
			],
			"outputs": []
		}
	}
}